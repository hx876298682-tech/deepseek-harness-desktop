{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.5",
  "description": "Native Electron desktop shell for the DeepSeek Harness Web UI.",
  "main": "main.js",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:smoke": "electron . --smoke-test",
    "test:update-utils": "node --test update-utils.test.js runtime.test.js image-input-defaults.test.js text-file-utils.test.js forum-plugin-utils.test.js",
    "dist:mac-arm64": "electron-builder --mac dmg --arm64",
    "dist:mac-x64": "electron-builder --mac dmg --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "productName": "DeepSeek Harness Desktop",
    "asar": true,
    "files": ["main.js", "preload.cjs", "resolve-dsh.js", "runtime.js", "image-input-defaults.js", "text-file-utils.js", "forum-plugin-utils.js", "update-utils.js", "update-section.js", "README.md", "LICENSE"],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "artifactName": "DeepSeekHarnessDesktop-${version}-${arch}.${ext}",
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }]
    },
    "win": { "artifactName": "DeepSeekHarnessDesktop-${version}-${arch}.${ext}", "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "linux": { "category": "Development", "artifactName": "DeepSeekHarnessDesktop-${version}-${arch}.${ext}", "target": [{ "target": "AppImage", "arch": ["x64"] }] },
    "publish": {
      "provider": "github",
      "owner": "hx876298682-tech",
      "repo": "deepseek-harness-desktop",
      "releaseType": "release"
    }
  }
}
